// share_team.lr — commit local work and generate a Port Key for a teammate.
//
// Usage (inside an LRM repo served by `lrm daemon`):
//   lrm run share_team.lr -- "wip: friday demo"
//
// The report captures the commit hash, mapping status, and the key itself,
// so the whole handoff is auditable from one .txt file.
let argv = args();
let msg = "wip via script";
if len(argv) > 0 {
  msg = argv[0];
}

let s = lrm_status();
assert(s.ok, "inside an LRM repo");
if s.ok == false {
  fail("run this script inside an LRM repo");
}
print("branch: " + s.branch + " clean: " + str(s.clean));

// Commit anything pending.
if s.clean == false {
  let c = lrm_commit(msg);
  assert(c.ok, "commit works");
  print("committed " + c.hash);
} else {
  print("nothing to commit");
}

// Generate the Port Key (needs internet for STUN; UPnP attempted).
let st = lrm_status();
let port = 18443;
let key = lrm_share(port, true);
assert(key.ok, "port key generated");
if key.ok {
  print("WAN: " + key.wan);
  print("KEY: " + key.key);
  assert(key.listening, "daemon is listening for the teammate");
  if key.mapped == false {
    log("WARNING: no router mapping — forward the port manually");
  }
}
